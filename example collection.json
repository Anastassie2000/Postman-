    {
      "name": "Create a new Car",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "let jsonData=pm.response.json()\r",
              "let carId=jsonData.data.id\r",
              "let carMileage=jsonData.data.mileage\r",
              "let carReported=jsonData.data.carCreatedAt\r",
              "pm.collectionVariables.set(\"carId\", carId)\r",
              "console.log(\"car ID: \"+ carId)\r",
              "pm.collectionVariables.set(\"carMileage\",carMileage)\r",
              "console.log(\"carMileage: \"+ carMileage)\r",
              "pm.collectionVariables.set(\"carReported\", carReported)\r",
              "console.log(\"carReported: \"+ carReported)\r",
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "})\r",
              "pm.test(\"Logo is string with png use reg ex\",function(){\r",
              "    pm.expect(jsonData.data.logo).to.match(/^[a-zA-Z]+\\.png$/);\r",
              "    pm.expect(jsonData.data.logo).to.be.a('string');\r",
              "})\r",
              "\r",
              "\r",
              "    "
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "console.clear()\r",
              "function getRandomInt(min,max){\r",
              "    return Math.floor(Math.random() * (max - min + 1)) + min;\r",
              "}\r",
              "let  myRandomBrand= getRandomInt(1, 5);\r",
              "console.log(\"Brand: \"+myRandomBrand)\r",
              "pm.collectionVariables.set(\"myRandomBrand\", myRandomBrand);\r",
              "\r",
              "switch(myRandomBrand){\r",
              "   case 1: {myRandomModel = getRandomInt(1, 5);break;}\r",
              "   case 2: {myRandomModel = getRandomInt(6,10);break;}     \r",
              "   case 3: {myRandomModel = getRandomInt(11,15);break;}\r",
              "   case 4: {myRandomModel = getRandomInt(16,18);break;}    \r",
              "   case 5: {myRandomModel = getRandomInt(19,23);break;}\r",
              "}\r",
              "console.log(\"Model: \"+myRandomModel)\r",
              "pm.collectionVariables.set(\"myRandomModel\", myRandomModel);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
