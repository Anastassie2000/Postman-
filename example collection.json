    {
      "name": "SignUP",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "console.clear()\r",
              "let myRandomEmail = pm.variables.replaceIn('{{$randomEmail}}');\r",
              "console.log(myRandomEmail)\r",
              "pm.collectionVariables.set('myRandomEmail', myRandomEmail);\r",
              "let randomPassword=pm.variables.replaceIn('{{$randomPassword}}')\r",
              "let myRandomPassword=randomPassword.slice(0,10)+'1fA'\r",
              "console.log(myRandomPassword)\r",
              "pm.collectionVariables.set('myRandomPassword', myRandomPassword);\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData=pm.response.json()\r",
              "let userId=jsonData.data.userId\r",
              "pm.collectionVariables.set(\"userId\", userId)\r",
              "console.log(\"user ID: \"+userId)\r",
              "\r",
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "})\r",
              "\r",
              "pm.test(\"UserId is Number\",function(){\r",
              "    pm.expect(userId).to.be.a('number')\r",
              "})\r",
              " let schema={\r",
              "  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\r",
              "  \"title\": \"Generated schema for Root\",\r",
              "  \"type\": \"object\",\r",
              "  \"properties\": {\r",
              "    \"status\": {\r",
              "      \"type\": \"string\",\r",
              "      \"enum\": [\"ok\"]\r",
              "    },\r",
              "    \"data\": {\r",
              "      \"type\": \"object\",\r",
              "      \"properties\": {\r",
              "        \"userId\": {\r",
              "          \"type\": \"number\",\r",
              "          \"minimum\": 1\r",
              "        },\r",
              "        \"photoFilename\": {\r",
              "          \"type\": \"string\"\r",
              "        },\r",
              "        \"distanceUnits\": {\r",
              "          \"type\": \"string\",\r",
              "          \"enum\": [\"ml\", \"km\"]\r",
              "        },\r",
              "        \"currency\": {\r",
              "          \"type\": \"string\",\r",
              "          \"enum\": [\"usd\", \"gbp\",\"uah\",\"pln\",\"eur\"]\r",
              "        }\r",
              "      },\r",
              "      \"required\": [\r",
              "        \"userId\",\r",
              "        \"photoFilename\",\r",
              "        \"distanceUnits\",\r",
              "        \"currency\"\r",
              "      ]\r",
              "    }\r",
              "  },\r",
              "  \"required\": [\r",
              "    \"status\",\r",
              "    \"data\"\r",
              "  ]\r",
              "}\r",
              "\r",
              "pm.test(\"Response body matches schema\", function () {\r",
              "pm.response.to.have.jsonSchema(schema)})\r",
              "pm.test(\"Status property is success\", function () {\r",
              "    pm.expect(jsonData.status).to.be.a('string');\r",
              "    pm.expect(jsonData.status).to.eql('ok'); \r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
