  "item": [
    {
      "name": "Sign Up",
      "item": [
        {
          "name": "Name Required",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "console.clear()\r",
                  "let myRandomEmail = pm.variables.replaceIn('{{$randomEmail}}');\r",
                  "console.log(myRandomEmail)\r",
                  "pm.collectionVariables.set('myRandomEmail', myRandomEmail);\r",
                  "let randomPassword=pm.variables.replaceIn('{{$randomPassword}}')\r",
                  "let myRandomPassword=randomPassword.slice(0,10)+'1fA'\r",
                  "console.log(myRandomPassword)\r",
                  "pm.collectionVariables.set('myRandomPassword', myRandomPassword);\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let jsonData=pm.response.json()\r",
                  "pm.test(\"Test Name is required\", function () {\r",
                  "    pm.expect(jsonData.message).to.eql(\"Name is required\")\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Test Status is error\", function () {\r",
                  "pm.response.to.have.status(400);\r",
                  "})"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"lastName\": \"{{$randomLastName}}\",\r\n    \"email\": \"{{myRandomEmail}}\",\r\n    \"password\": \"{{myRandomPassword}}\",\r\n    \"repeatPassword\": \"{{myRandomPassword}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://{{path}}/api/auth/signup",
              "protocol": "https",
              "host": [
                "{{path}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            }
          },
          "response": []
        },
