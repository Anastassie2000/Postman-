        {
          "name": "Name length 21",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "console.clear()\r",
                  "let additionalName=pm.variables.replaceIn('{{$randomFirstName}}');\r",
                  "let myRandomName=pm.variables.replaceIn('{{$randomFirstName}}').padEnd(21,\"-\"+additionalName);\r",
                  "console.log(\"Name: \"+myRandomName) \r",
                  "pm.collectionVariables.set('myRandomName', myRandomName);\r",
                  "\r",
                  "let myRandomEmail = pm.variables.replaceIn('{{$randomEmail}}');\r",
                  "console.log(\"Email:\"+ myRandomEmail)\r",
                  "pm.collectionVariables.set('myRandomEmail', myRandomEmail);\r",
                  "\r",
                  "let randomPassword=pm.variables.replaceIn('{{$randomPassword}}')\r",
                  "let myRandomPassword=randomPassword.slice(0,10)+'1fA'\r",
                  "console.log(\"password: \"+myRandomPassword)\r",
                  "pm.collectionVariables.set('myRandomPassword', myRandomPassword);\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
